# ============================================
# Données et index (à garder ou ignorer)
# ============================================

# Option 1: IGNORER tout l'index (recommandé pour GitHub)
data/index/
!data/index/.gitkeep
!data/index/README.md

# Option 2: GARDER le JSON mais ignorer le stockage Qdrant
# data/index/qdrant_storage/
# !data/index/chunks_metadata.json

# Données brutes (à garder, donc pas dans .gitignore)
# data/raw/ - NE PAS IGNORER (tes fichiers TXT sont importants)

# ============================================
# Modèles téléchargés (trop lourds)
# ============================================
models/
!models/.gitkeep

